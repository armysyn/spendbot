# spendbot settings. Lines starting with # are comments. Edit with Notepad or any text
# editor and restart the program afterwards.

# The page is only reachable from this computer.
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=http://127.0.0.1:8080
OPEN_BROWSER=1
LOG_FORMAT=text
TZ=Asia/Almaty

# Local model through the free Ollama app (https://ollama.com).
# It is easier to pick and download a model on the Settings page.
ANALYSIS_LLM_MODEL=qwen2.5:7b

# --- optional ---
# Telegram bot: a token from @BotFather and your chat_id. Empty — everything is on the page.
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Page password. Needed if you open the page to other devices on your network
# (then set LISTEN_ADDR=0.0.0.0:8080 and PUBLIC_URL=http://<computer address>:8080).
WEB_PASSWORD=

# Look for new versions on GitHub every 5 minutes and offer them on the Settings page.
# UPDATE_CHECK=off
