# Copy to deploy/.env for a server or a Mac with all parts (Telegram, ClickHouse, models).
# For a single computer see deploy/dist/spendbot.env.

# --- Telegram (optional) ---
TELEGRAM_TOKEN=                # bot token from @BotFather; empty = no bot
TELEGRAM_ALLOWED_CHAT_ID=      # your chat_id, see "Telegram" in README.md

# --- basics ---
TZ=Asia/Almaty
DB_PATH=/data/spend.db         # make run overrides it with ./spend.db
INGEST_TOKEN=                  # secret for the iPhone automation; empty = generated on first start
QUIET_HOURS="23:00-08:00"
WEEKLY_REPORT="MON 10:00"
EVENING_REPORT="21:00"
BACKUP_KEEP=14
NO_TX_ALERT_DAYS=3
AUTO_MIN_HITS=3

# --- bot model (optional) ---
LLM=off                        # off | claude | openai
CLAUDE_MODEL=haiku             # LLM=claude goes through the Claude Code CLI (claude -p); needs a claude login
CLAUDE_BIN=claude
LLM_BASE_URL=                  # LLM=openai: e.g. http://mac:11434/v1 for Ollama on a Mac
LLM_MODEL=
LLM_API_KEY=

# --- statement analysis ---
CLICKHOUSE_URL=                # http://localhost:8123; empty = everything is computed from SQLite
CLICKHOUSE_DB=spend
ANALYSIS_LLM=on                # on | off — local model for guesses and tips
ANALYSIS_LLM_URL=http://localhost:11434/v1
ANALYSIS_LLM_MODEL=qwen2.5:7b
BATCH_SIZE=20                  # merchants per question batch
BATCH_MAX_AGE=30m              # a partial batch is made when a question waits longer

# --- web page ---
WEB_PASSWORD=                  # empty = no password, open to the network; openssl rand -base64 12
PUBLIC_URL=http://localhost:8080   # address used in Telegram links
